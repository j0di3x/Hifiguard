    "Paused: macOS keeps picking headphone mic": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقف مؤقتًا: يواصل macOS اختيار ميكروفون السماعات"
