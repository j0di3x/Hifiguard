    "You're up to date.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك أحدث إصدار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কাছে সর্বশেষ সংস্করণ আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist auf dem neuesten Stand."
          }
        },
        "es": {
