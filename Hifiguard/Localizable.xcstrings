    "Allow Hifiguard under Screen & System Audio Recording, then turn the equalizer off and on.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ Hifiguard ضمن تسجيل الشاشة وصوت النظام، ثم أوقف معادل الصوت وشغّله."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্রিন ও সিস্টেম অডিও রেকর্ডিংয়ে Hifiguard-কে অনুমতি দিন, তারপর ইকুয়ালাইজার বন্ধ করে চালু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Hifiguard unter „Bildschirm- und Systemaudioaufnahme“ und schalte den Equalizer dann aus und wieder ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Hifiguard en Grabación de pantalla y audio del sistema, y luego desactiva y activa el ecualizador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Hifiguard dans Enregistrement de l’écran et de l’audio système, puis désactivez et réactivez l’égaliseur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन और सिस्टम ऑडियो रिकॉर्डिंग में Hifiguard को अनुमति दें, फिर इक्वलाइज़र बंद करके चालू करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a Hifiguardot a Képernyő- és rendszerhang-rögzítés részben, majd kapcsold ki és be a hangszínszabályzót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan Hifiguard di Perekaman Layar & Audio Sistem, lalu matikan dan nyalakan equalizer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o Hifiguard em Gravação de Tela e Áudio do Sistema e depois desative e ative o equalizador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Hifiguard в разделе «Запись экрана и системного звука», затем выключите и включите эквалайзер."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte Hifiguard v časti Nahrávanie obrazovky a systémového zvuku a potom ekvalizér vypnite a zapnite."
          }
        }
      }
    },
