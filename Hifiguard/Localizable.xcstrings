    "Hifiguard will copy itself to your Applications folder and restart from there.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سينسخ Hifiguard نفسه إلى مجلد التطبيقات ويعيد التشغيل من هناك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hifiguard নিজেকে আপনার Applications ফোল্ডারে কপি করে সেখান থেকে আবার চালু হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hifiguard kopiert sich in deinen Ordner „Programme“ und startet von dort neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hifiguard se copiará en tu carpeta Aplicaciones y se reiniciará desde allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hifiguard va se copier dans votre dossier Applications et redémarrer depuis celui-ci."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hifiguard खुद को आपके Applications फ़ोल्डर में कॉपी करेगा और वहाँ से फिर शुरू होगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Hifiguard átmásolja magát az Alkalmazások mappába, és onnan indul újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hifiguard akan menyalin dirinya ke folder Aplikasi dan memulai ulang dari sana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Hifiguard vai se copiar para a pasta Aplicativos e reiniciar a partir dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Hifiguard скопируется в папку «Программы» и перезапустится оттуда."
