    "Turn Hi-fi Lock off and on to retry": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف قفل Hi-fi ثم شغّله لإعادة المحاولة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবার চেষ্টা করতে হাই-ফাই লক বন্ধ করে চালু করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte die Hi-fi-Sperre aus und wieder ein, um es erneut zu versuchen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva y activa el bloqueo hi-fi para reintentar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez puis réactivez le verrou hi-fi pour réessayer"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर से कोशिश करने के लिए हाई-फ़ाई लॉक बंद करके चालू करें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az újrapróbáláshoz kapcsold ki és be a Hi-fi zárat"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan lalu nyalakan Kunci Hi-fi untuk mencoba lagi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative e ative a trava hi-fi para tentar de novo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите и включите блокировку Hi-fi, чтобы повторить"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnite a zapnite Hi-fi zámok a skúste to znova"
          }
        }
      }
    },
