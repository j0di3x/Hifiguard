{
  "sourceLanguage": "en",
  "strings": {
    "%@ chose headphone mic directly. Pick Mac mic in that app.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختار ميكروفون السماعات مباشرة: %@. اختر ميكروفون Mac في ذلك التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সরাসরি হেডফোনের মাইক বেছে নিয়েছে: %@। সেই অ্যাপে Mac মাইক বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopfhörermikrofon direkt gewählt von: %@. Wähle dort das Mac-Mikrofon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Micrófono de los auriculares elegido directamente por: %@. Elige allí el micrófono del Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Micro du casque choisi directement par : %@. Choisissez-y le micro du Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हेडफ़ोन माइक सीधे चुना गया: %@। उस ऐप में Mac माइक चुनें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Közvetlenül a fejhallgató mikrofonját választotta: %@. Ott válaszd a Mac mikrofonját."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon headphone dipilih langsung oleh: %@. Pilih mikrofon Mac di app tersebut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfone dos fones escolhido diretamente por: %@. Escolha o microfone do Mac nesse app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон наушников выбран напрямую: %@. Выберите там микрофон Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofón slúchadiel si priamo vybrali: %@. Vyberte v danej aplikácii mikrofón Macu."
          }
        }
      }
    },
