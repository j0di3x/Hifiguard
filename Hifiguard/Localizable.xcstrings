            "state": "translated",
            "value": "A legfrissebb verziót használod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah menggunakan versi terbaru."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está em dia."
          }
        },
        "ru": {
